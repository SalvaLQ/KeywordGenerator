<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="590" Width="400"  Height="580"
		  xmlns:styles="clr-namespace:Material.Styles;assembly=Material.Styles"
                 xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
		 xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
		    xmlns:p="clr-namespace:SuperKeywordGenerator.LocalizationResources;assembly=SuperKeywordGenerator"
        x:Class="SuperKeywordGenerator.Views.SettingsWnd"
        Title="{x:Static p:SettingsRes.WindowTitle}"  WindowStartupLocation="CenterOwner"     >
	<Grid RowDefinitions="250,Auto,Auto,Auto" ColumnDefinitions="" Margin="10" >
		<Grid Grid.Row="0" RowDefinitions="Auto,*">
			<TextBlock  Classes="Headline6"  Grid.Row="0"  HorizontalAlignment="Left" Margin="0,0,0,5" 
						Text="{x:Static p:SettingsRes.KeyProviders}"/>
      <controls:Card Grid.Row="1" Padding="0,4">
				<ListBox  ItemsSource="{Binding KeywordProviders}"    >
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Height" Value="35"/>
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="0" Margin="0">
								<CheckBox IsChecked="{Binding Active}" Classes="Accent"  ></CheckBox>
								<TextBlock Text="{Binding Name}"  />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</controls:Card>
		</Grid>
		<StackPanel  Grid.Row="1" Margin="0,10,0,0"  >
			<TextBlock Classes="Headline6" HorizontalAlignment="Left"    Text="{x:Static p:SettingsRes.delayTitle}"/>
			<TextBox HorizontalAlignment="Stretch" UseFloatingWatermark="True" Classes="Outline" wpf:TextFieldAssist.Label="{x:Static p:SettingsRes.delayMin}" Text="{Binding MinDelay}"  ></TextBox>
			<TextBox HorizontalAlignment="Stretch"  UseFloatingWatermark="True" Classes="Outline" wpf:TextFieldAssist.Label="{x:Static p:SettingsRes.delayMax}"    Text="{Binding MaxDelay}"    ></TextBox>
		</StackPanel>
		<TextBox HorizontalAlignment="Stretch"  Grid.Row="2"  UseFloatingWatermark="True" Classes="Outline" wpf:TextFieldAssist.Label="{x:Static p:SettingsRes.threadsTitle}"  Text="{Binding Threads}"     ></TextBox>
		<StackPanel Margin="0,10,0,0" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Click="btAcept_Click"   Content="{x:Static p:CommonRes.acept}"/>
			<Button Margin="5,0,0,0" Click="btCancel_Click"   Content="{x:Static p:CommonRes.cancel}"/>
		</StackPanel>
	</Grid>
</Window>
